# ───────────────────────────────────────────────────────────────
# Echo Web — environment template
# Copy this file to `apps/web/.env.local` and adjust if needed.
# Variables must be prefixed NEXT_PUBLIC_ to be exposed to the browser.
# ───────────────────────────────────────────────────────────────

# Base URL of the Echo API (apps/api), used for REST calls.
NEXT_PUBLIC_API_URL=http://localhost:8787

# WebSocket endpoint for the real-time coaching metrics stream.
NEXT_PUBLIC_WS_URL=ws://localhost:8787/ws/coaching

# WebSocket endpoint for the live transcription stream.
NEXT_PUBLIC_WS_LIVE_URL=ws://localhost:8787/ws/live
