# ───────────────────────────────────────────────────────────────
# Echo API — environment template
# Copy this file to `apps/api/.env` and fill in real values.
# NEVER commit the real .env (it is git-ignored).
# ───────────────────────────────────────────────────────────────

# ── Server ──────────────────────────────────────────────────────
PORT=8787
# silent | error | warn | info | debug
LOG_LEVEL=info

# ── Google Gemini (required for AI review + mock interview) ──────
# Get a key from https://aistudio.google.com/ and paste it locally.
GEMINI_API_KEY=

# Model + generation tuning (optional — sensible defaults applied)
GEMINI_REVIEW_MODEL=gemini-2.5-flash
GEMINI_REVIEW_TEMPERATURE=0.2
GEMINI_REVIEW_MAX_TOKENS=2048
GEMINI_MOCK_MODEL=gemini-2.5-flash
GEMINI_MOCK_TEMPERATURE=0.2
GEMINI_MOCK_MAX_TOKENS=2048

# ── Google Cloud Speech-to-Text (required for LIVE transcription) ─
# Create a service account, enable the Speech-to-Text API, download the
# JSON key, and point this at the absolute path of that file.
# Credential JSON files are git-ignored (see .gitignore). Do NOT commit them.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account-key.json
SPEECH_LANGUAGE=en-US
